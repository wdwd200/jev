# Copy to .env and fill in real values. Never commit .env.

# Jev
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_ENDPOINT=/v1/systemone
JEV_MODEL=jev-latest

# DeepSeek V4.1 Flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ENDPOINT=/chat/completions
DEEPSEEK_MODEL=deepseek-flash

# Optional request controls
REQUEST_TIMEOUT_SECONDS=120

# Local persistence and strategy versions
DATABASE_PATH=.runtime/jev_context.sqlite3
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=0
JEV_THRESHOLD=0.5
EVIDENCE_TOKEN_BUDGET=6000
WORKSPACE_TOKEN_LIMIT=800000
CHUNK_RULE_VERSION=hybrid-512-v1
SELECTION_STRATEGY_VERSION=jev-threshold-v1
STANDARD_RAG_CONFIGURED=0
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=100
